[
    {
        "name": ":clear",
        "ex": "ctext = '';\nvertices = [];\nedges = [];"
    },
    {
        "name": "alert",
        "ex": "alert('alert')"
    },
    {
        "name": ":cube",
        "ex": "ctext = '';readfile('../assets/cube.obj');"
    },
    {
        "name": ":rot",
        "ex": "xanglev = rotationspeed;\nyanglev = rotationspeed*.9;\nctext = '';"
    },
    {
        "name": ":srot",
        "ex": "xanglev = 0;\nyanglev = 0;\nctext='';"
    },
    {
        "name": ":initrot",
        "ex": "ctext='';xangle=0;yangle=0"
    },
    {
        "name": "set xangle",
        "cond": "ctext.slice(0, 7)=='xangle='",
        "ex": "xangle=ctext.slice(7)/180*Math.PI;ctext=''"
    },
    {
        "name": "set yangle",
        "cond": "ctext.slice(0, 7)=='yangle='",
        "ex": "yangle=ctext.slice(7)/180*Math.PI;ctext=''"
    },
    {
        "name": "+= xangle",
        "cond": "ctext.slice(0, 8)=='xangle+='",
        "ex": "xangle+=ctext.slice(8)/180*Math.PI;ctext=''"
    },
    {
        "name": "+= yangle",
        "cond": "ctext.slice(0, 8)=='yangle+='",
        "ex": "yangle+=ctext.slice(8)/180*Math.PI;ctext=''"
    },
    {
        "name": "open file",
        "cond": "ctext.slice(0,2)=='./'",
        "ex": "readfile('../assets/'+ctext.slice(2));ctext=''"
    }
]